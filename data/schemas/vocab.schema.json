{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hunter-english:data:vocab:v1",
  "title": "vocab",
  "type": "object",
  "required": ["topic", "en", "ru"],
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "en": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9 .'/-]+$"
    },
    "ru": {
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "type": "string",
      "pattern": "^audio/(words|vocab)/cori/[a-z0-9-]+\\.opus$"
    }
  }
}
