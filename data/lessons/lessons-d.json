    {
      "id": "les-d-01",
      "rank": "D",
      "module": "mod-d-1",
      "title": "Present Continuous: процесс. still, these days",
      "grammar_point": {
        "id": "gp-d-01",
        "title_ru": "Present Continuous: закрепление",
        "rule_md": "**Present Continuous — процесс прямо сейчас.**\nam / is / are + глагол+-ing: I **am working** now. She **is sleeping**.\nОтрицание: I **am not** working. Вопрос: **Are** you working?\n**still** = «всё ещё»: I am **still** learning English.\n**these days** = «в последнее время»: These days I am living in Moscow.\nСлова-маркеры: now, still, these days, Look!, Listen!",
        "phrase_ids": ["ph-d-0001", "ph-d-0002", "ph-d-0003", "ph-d-0004", "ph-d-0005"],
        "trap_id": "trap-articles"
      },
